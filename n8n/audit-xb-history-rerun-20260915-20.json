{
  "name": "Audit - XB Historical Rerun 2026-09-15 to 20",
  "nodes": [
    {
      "parameters": {},
      "id": "manual",
      "name": "เริ่มรันย้อนหลัง",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-620, 120]
    },
    {
      "parameters": {
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/daily_recon_jobs?select=id,business_date,company,status,is_archived&business_date=gte.2026-09-15&business_date=lte.2026-09-20&company=in.(3XB,MC8,MR9,PS8,UR9)&is_archived=eq.false&order=business_date.asc,company.asc",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "id": "list-jobs",
      "name": "Supabase: อ่านงานย้อนหลัง XB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-380, 120],
      "credentials": {
        "supabaseApi": {
          "id": "dGndiinLb7AKnjIu",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw=$input.all().map(item=>item.json); const rows=raw.flatMap(value=>Array.isArray(value)?value:Array.isArray(value?.data)?value.data:[value]).filter(row=>row?.id&&!row.is_archived); if(!rows.length) throw new Error('ไม่พบงานเครือ XB วันที่ 2026-09-15 ถึง 2026-09-20'); return rows.map(row=>({json:{job_id:row.id,business_date:row.business_date,company:row.company,previous_status:row.status}}));"
      },
      "id": "prepare-jobs",
      "name": "เตรียมงานทีละบริษัทและวัน",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-140, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/rpc/retry_daily_recon_job",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_job_id: $json.job_id }) }}",
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "id": "retry-jobs",
      "name": "Supabase: ส่งงานย้อนหลังเข้าคิวใหม่",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, 120],
      "credentials": {
        "supabaseApi": {
          "id": "dGndiinLb7AKnjIu",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows=$input.all().map(item=>item.json).filter(row=>row?.id); return [{json:{queued:rows.length,dates:['2026-09-15','2026-09-16','2026-09-17','2026-09-18','2026-09-19','2026-09-20'],companies:['3XB','MC8','MR9','PS8','UR9'],jobs:rows.map(row=>({id:row.id,business_date:row.business_date,company:row.company,status:row.status,rerun_requested_at:row.rerun_requested_at}))}}];"
      },
      "id": "summary",
      "name": "สรุปงานที่เข้าคิว",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [380, 120]
    }
