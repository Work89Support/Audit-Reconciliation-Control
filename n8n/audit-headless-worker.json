tled: grab(/à¹„à¸”à¹‰à¸£à¸±à¸š(?:à¸¢à¸­à¸”)?(?:à¸ˆà¸£à¸´à¸‡|à¸ à¸²à¸¢à¹ƒà¸™à¹€à¸”à¸·à¸­à¸™)\\s*([\\d,]+(?:\\.\\d+)?)/),\n      excess: grab(/à¸ªà¸°à¸ªà¸¡à¹€à¸à¸´à¸™(?:à¹€à¸”à¸·à¸­à¸™)?\\s*([\\d,]+(?:\\.\\d+)?)\\s*à¸šà¸²à¸—/),\n    };\n  }\n\n  /* -------------------------------------------------------------\n     à¸£à¸§à¸¡à¸£à¸²à¸¢à¸à¸²à¸£à¸‚à¹‰à¸²à¸¡à¸£à¸²à¸¢à¸‡à¸²à¸™\n     à¸£à¸²à¸¢à¸‡à¸²à¸™à¸à¸²à¸à¸¡à¸·à¸­_* à¸„à¸·à¸­à¸£à¸²à¸¢à¸¥à¸°à¹€à¸­à¸µà¸¢à¸”à¸‚à¸­à¸‡à¹à¸–à¸§ \"à¹€à¸•à¸´à¸¡à¸¡à¸·à¸­\" à¹ƒà¸™à¸£à¸²à¸¢à¸‡à¸²à¸™à¸šà¸±à¸à¸Šà¸µà¸à¸²à¸\n     à¸—à¸±à¹‰à¸‡à¸ªà¸­à¸‡à¹ƒà¸Šà¹‰ UUID à¹€à¸”à¸µà¸¢à¸§à¸à¸±à¸™ (à¸£à¸«à¸±à¸ªà¸­à¹‰à¸²à¸‡à¸­à¸´à¸‡ = à¸£à¸«à¸±à¸ªà¸£à¸²à¸¢à¸à¸²à¸£) à¸ˆà¸¶à¸‡à¸¢à¸¸à¸šà¹€à¸›à¹‡à¸™à¸£à¸²à¸¢à¸à¸²à¸£à¹€à¸”à¸µà¸¢à¸§\n     à¹‚à¸”à¸¢à¸¢à¸¶à¸”à¹à¸–à¸§à¸ˆà¸²à¸à¸£à¸²à¸¢à¸‡à¸²à¸™à¸šà¸±à¸à¸Šà¸µà¹€à¸›à¹‡à¸™à¸«à¸¥à¸±à¸ à¹à¸¥à¹‰à¸§à¹€à¸•à¸´à¸¡à¸‚à¹‰à¸­à¸¡à¸¹à¸¥à¸šà¸±à¸à¸Šà¸µà¸¥à¸¹à¸à¸„à¹‰à¸²/à¹€à¸„à¸£à¸”à¸´à¸•à¸ˆà¸²à¸à¸à¸²à¸à¸¡à¸·à¸­\n     ------------------------------------------------------------- */\n  const RANK = { bo_main: 3, manual_credit: 2, manual_payment: 1 };\n\n  function merge(records) {\n    const byRef = new Map();\n    const noRef = [];\n    records.forEach((r) => {\n      // à¸¢à¸¸à¸šà¹€à¸‰à¸žà¸²à¸°à¸£à¸²à¸¢à¸‡à¸²à¸™à¸„à¸¹à¹ˆà¸—à¸µà¹ˆà¸­à¸­à¸à¹à¸šà¸šà¸¡à¸²à¹ƒà¸«à¹‰à¹ƒà¸Šà¹‰ UUID à¹€à¸”à¸µà¸¢à¸§à¸à¸±à¸™à¹€à¸—à¹ˆà¸²à¸™à¸±à¹‰à¸™\n      // BO transaction export à¸­à¸²à¸ˆà¸¡à¸µà¸«à¸¥à¸²à¸¢à¸¢à¸­à¸”à¹à¸šà¹ˆà¸‡à¸ˆà¹ˆà¸²à¸¢à¸ à¸²à¸¢à¹ƒà¸•à¹‰ Ref à¹à¸¡à¹ˆà¹€à¸”à¸µà¸¢à¸§à¸à¸±à¸™à¹à¸¥à¸°à¸•à¹‰à¸­à¸‡à¸„à¸‡à¸—à¸¸à¸à¹à¸–à¸§à¹„à¸§à¹‰\n      if (!Object.prototype.hasOwnProperty.call(RANK, r.formatCode)) return noRef.push(r);\n      const ref = String(r.ref || \"\").trim();\n      if (!ref) return noRef.push(r);\n      const prev = byRef.get(ref);\n      if (!prev) return byRef.set(ref, { ...r, mergedFrom: [r.formatCode] });\n      const keepNew = (RANK[r.formatCode] || 0) > (RANK[prev.formatCode] || 0);\n      const base = keepNe