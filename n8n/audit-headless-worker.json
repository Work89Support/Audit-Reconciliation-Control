    {
      "parameters": {
        "jsCode": "/* =============================================================\n   Formats - à¸•à¸±à¸§à¸­à¹ˆà¸²à¸™à¸£à¸¹à¸›à¹à¸šà¸šà¹„à¸Ÿà¸¥à¹Œà¸ˆà¸£à¸´à¸‡à¸‚à¸­à¸‡à¹à¸œà¸™à¸à¸­à¸­à¸”à¸´à¸— (19-07-69 à¹€à¸›à¹‡à¸™à¸•à¹‰à¸™à¹à¸šà¸š)\n   à¸„à¸£à¸­à¸šà¸„à¸¥à¸¸à¸¡à¸£à¸²à¸¢à¸‡à¸²à¸™ 6 à¸Šà¸™à¸´à¸”à¸—à¸µà¹ˆà¸­à¸­à¸à¸ˆà¸²à¸à¸£à¸°à¸šà¸šà¸«à¸¥à¸±à¸‡à¸šà¹‰à¸²à¸™ (à¹ƒà¸Šà¹‰à¸£à¹ˆà¸§à¸¡à¸à¸±à¸™à¹„à¸”à¹‰à¸—à¸¸à¸à¸šà¸£à¸´à¸©à¸±à¸—)\n     1. à¸£à¸²à¸¢à¸‡à¸²à¸™à¸šà¸±à¸à¸Šà¸µà¸à¸²à¸ / à¸£à¸²à¸¢à¸‡à¸²à¸™à¸šà¸±à¸à¸Šà¸µà¸–à¸­à¸™      -> bo_main\n     2. à¸‚à¸­à¸–à¸­à¸™à¸„à¹ˆà¸²à¸„à¸­à¸¡à¸¡à¸´à¸Šà¸Šà¸±à¹ˆà¸™ (à¸ªà¸³à¹€à¸£à¹‡à¸ˆ/à¸¢à¸à¹€à¸¥à¸´à¸)   -> comm_req\n     3. à¸£à¸²à¸¢à¸‡à¸²à¸™à¸–à¸­à¸™à¹€à¸„à¸£à¸”à¸´à¸•                      -> credit_out\n     4. à¸£à¸²à¸¢à¸‡à¸²à¸™à¸à¸²à¸à¸¡à¸·à¸­_à¸£à¸²à¸¢à¸à¸²à¸£à¹€à¸„à¸£à¸”à¸´à¸•            -> manual_credit\n     5. à¸£à¸²à¸¢à¸‡à¸²à¸™à¸à¸²à¸à¸¡à¸·à¸­_à¸£à¸²à¸¢à¸à¸²à¸£ Payment          -> manual_payment\n     6. à¸£à¸²à¸¢à¸‡à¸²à¸™à¸à¸²à¸à¸¡à¸·à¸­_à¸£à¸²à¸¢à¸à¸²à¸£à¹‚à¸šà¸™à¸±à¸ª             -> manual_bonus\n   ============================================================= */\n\nconst Formats = (() => {\n  const norm = (s) =>\n    String(s ?? \"\")\n      .replace(/â€‹/g, \"\")\n      .replace(/[\\s_./\\\\:()\\[\\]-]+/g, \"\")\n      .trim()\n      .toLowerCase();\n  // Keep a second, exact header key because `norm()` intentionally removes\n  // underscores. Provider exports commonly contain both `id` and `_id`; if we\n  // index only by `norm()` those two columns collapse and `_id` incorrectly\n  // resolves to column A.\n  const exactHeader = (s) => String(s ?? \"\").replace(/â€‹/g, \"\").trim().toLowerCase();\n  const sapanProviderId = (value) => {\n    const hit = String(value ?? \"\").match(/\\b(?:sapan|spean)\\s*[:ï¼š]?\\s*([a-f0-9]{24})\\b/i);\n    return hit ? hit[1].toLowerCase() : \"\";\n  };\n\n  const HEADER_ALIASES = {\n    \"à¸£à¸«à¸±à¸ª\": [\"à¸£à¸«à¸±à¸ª\", \"transactionid\", \"id\"],\n    \"à¹€à¸§à¸¥à¸²\": [\"à¹€à¸§à¸¥à¸²\"],\n    \"à¸›à¸£à¸°à¹€à¸ à¸—\": [\"à¸›à¸£à¸°à¹€à¸ à¸—\"],\n    \"à¸¢à¸¹à¸ªà¹€à¸‹à¸­à¸£à¹Œ\": [\"à¸¢à¸¹à¸ªà¹€à¸‹à¸­à¸£à¹Œ\", \"username\", \"user\"],\n    \"à¸šà¸±à¸à¸Šà¸µà¸¥à¸¹à¸à¸„à¹‰à¸²à¹à¸šà¸šà¸¢à¹ˆà¸­\": [\"à¸šà¸±à¸à¸Šà¸µ\"],\n    \"à¸šà¸±à¸à¸Šà¸µà¸šà¸£à¸´à¸©à¸±à¸—à¹à¸šà¸šà¸¢à¹ˆà¸­\": [\"à¸šà¸±à¸à¸Šà¸µà¸šà¸£à¸´à¸©à¸±à¸—\"],\n    \"à¸¢à¸­à¸”à¹€à¸‡à¸´à¸™à¹à¸šà¸šà¸¢à¹ˆà¸­\": [\"à¸¢à¸­à¸”à¹€à¸‡à¸´à¸™\"],\n    \"à¹‚à¸™à¹‰à¸•\": [\"à¹‚à¸™à¹‰à¸•\", \"note\", \"à¸«à¸¡à¸²à¸¢à¹€à¸«à¸•à¸¸\"],\n    \"à¸œà¸¹à¹‰à¸”à¸³à¹€à¸™à¸´à¸™à¸à¸²à¸£\": [\"à¸œà¸¹à¹‰à¸”à¸³à¹€à¸™à¸´à¸™à¸à¸²à¸£\", \"operator\"],\n    \"à¸§à¸±à¸™à¸—à¸µà¹ˆà¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\": [\"à¸§à¸±à¸™à¸—à¸µà¹ˆà¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\", \"à¸§à¸±à¸™à¹€à¸§à¸¥à¸²à¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\", \"à¹€à¸§à¸¥à¸²à¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\", \"createdat\", \"createtime\", \"requesttime\"],\n    \"à¸§à¸±à¸™à¸—à¸µà¹ˆà¸˜à¸™à¸²à¸„à¸²à¸£\": [\"à¸§à¸±à¸™à¸—à¸µà¹ˆà¸˜à¸™à¸²à¸„à¸²à¸£\", \"à¸§à¸±à¸™à¹€à¸§à¸¥à¸²à¸˜à¸™à¸²à¸„à¸²à¸£\", \"à¹€à¸§à¸¥à¸²à¸˜à¸™à¸²à¸„à¸²à¸£\", \"paymenttime\", \"banktime\", \"transfertime\"],\n    \"à¸ˆà¸³à¸™à¸§à¸™à¹€à¸‡à¸´à¸™à¸à¸²à¸à¸ˆà¸£à¸´à¸‡\": [\"à¸ˆà¸³à¸™à¸§à¸™à¹€à¸‡à¸´à¸™à¸à¸²à¸à¸ˆà¸£à¸´à¸‡\", \"à¸¢à¸­à¸”à¸à¸²à¸à¸ˆà¸£à¸´à¸‡\", \"à¸¢à¸­à¸”à¸à¸²à¸\", \"depositamount\", \"realamount\", \"à¹‚à¸­à¸™à¸ˆà¸£à¸´à¸‡\"],\n    \"à¸ˆà¸³à¸™à¸§à¸™à¹€à¸‡à¸´à¸™à¸–à¸­à¸™à¸ˆà¸£à¸´à¸‡\": [\"à¸ˆà¸³à¸™à¸§à¸™à¹€à¸‡à¸´à¸™à¸–à¸­à¸™à¸ˆà¸£à¸´à¸‡\", \"à¸¢à¸­à¸”à¸–à¸­à¸™à¸ˆà¸£à¸´à¸‡\", \"à¸¢à¸­à¸”à¸–à¸­à¸™\", \"withdrawamount\", \"payoutamount\", \"p2pà¸ˆà¹ˆà¸²à¸¢\", \"à¸£à¸§à¸¡à¸«à¸±à¸à¹€à¸‡à¸´à¸™\"],\n    \"à¸Šà¸·à¹ˆà¸­à¸˜à¸™à¸²à¸„à¸²à¸£\": [\"à¸Šà¸·à¹ˆà¸­à¸˜à¸™à¸²à¸„à¸²à¸£\", \"à¸˜à¸™à¸²à¸„à¸²à¸£\", \"à¸Šà¹ˆà¸­à¸‡à¸—à¸²à¸‡\", \"provider\", \"paymentchannel\"],\n    \"à¹€à¸§à¸¥à¸²à¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\": [\"à¹€à¸§à¸¥à¸²à¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\", \"à¸§à¸±à¸™à¸—à¸µà¹ˆà¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\", \"à¸§à¸±à¸™à¹€à¸§à¸¥à¸²à¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\", \"createdat\", \"requesttime\"],\n    \"à¹€à¸§à¸¥à¸²à¸˜à¸™à¸²à¸„à¸²à¸£\": [\"à¹€à¸§à¸¥à¸²à¸˜à¸™à¸²à¸„à¸²à¸£\", \"à¸§à¸±à¸™à¸—à¸µà¹ˆà¸˜à¸™à¸²à¸„à¸²à¸£\", \"à¸§à¸±à¸™à¹€à¸§à¸¥à¸²à¸˜à¸™à¸²à¸„à¸²à¸£\", \"paymenttime\", \"banktime\"],\n    \"à¸ˆà¸³à¸™à¸§à¸™\": [\"à¸ˆà¸³à¸™à¸§à¸™\", \"à¸ˆà¸³à¸™à¸§à¸™à¹€à¸‡à¸´à¸™\", \"amount\", \"à¸¢à¸­à¸”à¹€à¸‡à¸´à¸™\"],\n    \"à¸ªà¸–à¸²à¸™à¸°\": [\"à¸ªà¸–à¸²à¸™à¸°\", \"status\"],\n  };\n  const aliasesOf = (name) => (HEADER_ALIASES[name] || [name]).map(norm);\n  const hasHeader = (cells, name) => aliasesOf(name).some((want) => cells.some((cell) => cell === want || cell.startsWith(want)));\n\n  /* ---------------- à¸™à¸´à¸¢à¸²à¸¡à¸£à¸¹à¸›à¹à¸šà¸š ---------------- */\n  const SPECS = [\n    {\n      code: \"bo_transaction_export\",\n      label: \"à¸£à¸²à¸¢à¸‡à¸²à¸™à¸˜à¸¸à¸£à¸à¸£à¸£à¸¡ BO\",\n      side: \"bo\",\n      need: [\"à¸£à¸«à¸±à¸ª\", \"à¹€à¸§à¸¥à¸²\", \"à¸›à¸£à¸°à¹€à¸ à¸—\", \"à¸¢à¸¹à¸ªà¹€à¸‹à¸­à¸£à¹Œ\", \"à¸Šà¸·à¹ˆà¸­à¸˜à¸™à¸²à¸„à¸²à¸£\", \"à¸ˆà¸³à¸™à¸§à¸™\", \"à¸œà¸¹à¹‰à¸”à¸³à¹€à¸™à¸´à¸™à¸à¸²à¸£\"],\n    },\n    {\n      code: \"bo_compact\",\n      label: \"à¸£à¸²à¸¢à¸‡à¸²à¸™à¸šà¸±à¸à¸Šà¸µà¸à¸²à¸-à¸–à¸­à¸™ (BO à¹à¸šà¸šà¸¢à¹ˆà¸­)\",\n      side: \"bo\",\n      need: [\"à¹€à¸§à¸¥à¸²\", \"à¸›à¸£à¸°à¹€à¸ à¸—\", \"à¸¢à¸¹à¸ªà¹€à¸‹à¸­à¸£à¹Œ\", \"à¸šà¸±à¸à¸Šà¸µà¸šà¸£à¸´à¸©à¸±à¸—à¹à¸šà¸šà¸¢à¹ˆà¸­\", \"à¸¢à¸­à¸”à¹€à¸‡à¸´à¸™à¹à¸šà¸šà¸¢à¹ˆà¸­\"],\n    },\n    {\n      code: \"bo_main\",\n      label: \"à¸£à¸²à¸¢à¸‡à¸²à¸™à¸šà¸±à¸à¸Šà¸µà¸à¸²à¸-à¸–à¸­à¸™ (BO)\",\n      side: \"bo\",\n      need: [\"à¸§à¸±à¸™à¸—à¸µà¹ˆà¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\", \"à¸§à¸±à¸™à¸—à¸µà¹ˆà¸˜à¸™à¸²à¸„à¸²à¸£\", \"à¸ˆà¸³à¸™à¸§à¸™à¹€à¸‡à¸´à¸™à¸à¸²à¸à¸ˆà¸£à¸´à¸‡\", \"à¸ˆà¸³à¸™à¸§à¸™à¹€à¸‡à¸´à¸™à¸–à¸­à¸™à¸ˆà¸£à¸´à¸‡\", \"à¸Šà¸·à¹ˆà¸­à¸˜à¸™à¸²à¸„à¸²à¸£\"],\n    },\n    {\n      code: \"manual_credit\",\n      label: \"à¸à¸²à¸à¸¡à¸·à¸­ - à¸£à¸²à¸¢à¸à¸²à¸£à¹€à¸„à¸£à¸”à¸´à¸•\",\n      side: \"bo\",\n      need: [\"à¹€à¸§à¸¥à¸²à¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\", \"à¹€à¸§à¸¥à¸²à¸˜à¸™à¸²à¸„à¸²à¸£\", \"à¹€à¸¥à¸‚à¸šà¸±à¸à¸Šà¸µà¸˜à¸™à¸²à¸„à¸²à¸£à¸ªà¸¡à¸²à¸Šà¸´à¸\", \"à¹€à¸¥à¸‚à¸šà¸±à¸à¸Šà¸µà¸˜à¸™à¸²à¸„à¸²à¸£à¸šà¸£à¸´à¸©à¸±à¸—\", \"à¸ˆà¸³à¸™à¸§à¸™\"],\n    },\n    {\n      code: \"manual_payment\",\n      label: \"à¸à¸²à¸à¸¡à¸·à¸­ - à¸£à¸²à¸¢à¸à¸²à¸£ Payment\",\n      side: \"bo\",\n      need: [\"à¹€à¸§à¸¥à¸²à¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\", \"à¹€à¸¥à¸‚à¸„à¸³à¸ªà¸±à¹ˆà¸‡à¸Šà¸³à¸£à¸°\", \"à¸Šà¹ˆà¸­à¸‡à¸—à¸²à¸‡\", \"à¸šà¸±à¸à¸Šà¸µà¸šà¸£à¸´à¸©à¸±à¸—\", \"à¸ˆà¸³à¸™à¸§à¸™\"],\n    },\n    {\n      code: \"manual_bonus\",\n      label: \"à¸à¸²à¸à¸¡à¸·à¸­ - à¸£à¸²à¸¢à¸à¸²à¸£à¹‚à¸šà¸™à¸±à¸ª\",\n      side: \"aux\",\n      need: [\"à¹€à¸§à¸¥à¸²à¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\", \"à¹‚à¸›à¸£à¹‚à¸¡à¸Šà¸±à¹ˆà¸™\", \"à¸¢à¸­à¸”à¸à¹ˆà¸­à¸™à¹€à¸•à¸´à¸¡\", \"à¹‚à¸šà¸™à¸±à¸ª\"],\n    },\n    {\n      code: \"comm_req\",\n      label: \"à¸‚à¸­à¸–à¸­à¸™à¸„à¹ˆà¸²à¸„à¸­à¸¡à¸¡à¸´à¸Šà¸Šà¸±à¹ˆà¸™\",\n      side: \"aux\",\n      need: [\"à¸§à¸±à¸™/à¹€à¸§à¸¥à¸²\", \"à¸£à¸«à¸±à¸ªà¸ªà¸¡à¸²à¸Šà¸´à¸\", \"à¸ˆà¸³à¸™à¸§à¸™à¹€à¸‡à¸´à¸™\", \"à¸ªà¸–à¸²à¸™à¸°\", \"à¸”à¸³à¹€à¸™à¸´à¸™à¸à¸²à¸£à¹‚à¸”à¸¢\"],\n    },\n    {\n      code: \"credit_out\",\n      label: \"à¸£à¸²à¸¢à¸‡à¸²à¸™à¸–à¸­à¸™à¹€à¸„à¸£à¸”à¸´à¸•\",\n      side: \"aux\",\n      need: [\"à¹€à¸§à¸¥à¸²à¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\", \"à¸£à¸«à¸±à¸ªà¸ªà¸¡à¸²à¸Šà¸´à¸\", \"à¹€à¸„à¸£à¸”à¸´à¸•à¸à¹ˆà¸­à¸™\", \"à¸ˆà¸³à¸™à¸§à¸™\", \"à¹€à¸„à¸£à¸”à¸´à¸•à¸«à¸¥à¸±à¸‡\"],\n    },\n  ];\n\n  /* ---------------- PM gateway (à¸¢à¸·à¸”à¸«à¸¢à¸¸à¹ˆà¸™: à¹à¸•à¹ˆà¸¥à¸°à¹€à¸ˆà¹‰à¸²à¸„à¸­à¸¥à¸±à¸¡à¸™à¹Œà¸•à¹ˆà¸²à¸‡à¸à¸±à¸™) ----------------\n     à¹€à¸Šà¹ˆà¸™ MYPAY(id,amount,provider,status,requestTime) Â· ATP(à¸§à¸±à¸™à¸—à¸µà¹ˆ,Ref,Username,à¸˜à¸™à¸²à¸„à¸²à¸£,à¸ªà¸£à¹‰à¸²à¸‡à¸à¸²à¸,à¹‚à¸­à¸™à¸ˆà¸£à¸´à¸‡,Status)\n          CBY(à¸§à¸±à¸™à¸—à¸µà¹ˆà¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£,Ref Id,à¸ˆà¸³à¸™à¸§à¸™à¹€à¸‡à¸´à¸™,à¸ªà¸–à¸²à¸™à¸°) Â· CBY à¸–à¸­à¸™(...,à¸ˆà¸³à¸™à¸§à¸™à¹€à¸‡à¸´à¸™,à¸„à¹ˆà¸²à¸˜à¸£à¸£à¸¡à¹€à¸™à¸µà¸¢à¸¡,à¸£à¸§à¸¡à¸«à¸±à¸à¹€à¸‡à¸´à¸™,à¸ªà¸–à¸²à¸™à¸°)\n     à¸•à¸£à¸§à¸ˆà¸ˆà¸±à¸šà¸ˆà¸²à¸: à¸¡à¸µà¸„à¸­à¸¥à¸±à¸¡à¸™à¹Œà¸§à¸±à¸™à¸—à¸µà¹ˆ + à¸ªà¸–à¸²à¸™à¸° + à¸¢à¸­à¸” (à¹à¸¥à¸°à¹„à¸¡à¹ˆà¹€à¸‚à¹‰à¸² SPEC à¸­à¸·à¹ˆà¸™) */\n  const PM_DATE = [\"paymenttime\", \"expiredtime\", \"updatetime\", \"à¸§à¸±à¸™à¹€à¸§à¸¥à¸²à¸­à¸±à¸žà¹€à¸”à¸•\", \"à¸§à¸±à¸™à¹€à¸§à¸¥à¸²\", \"à¸§à¸±à¸™à¸—à¸µà¹ˆà¸—à¸³à¸£à¸²à¸¢à¸à¸²à¸£\", \"à¸§à¸±à¸™à¸—à¸µà¹ˆ\", \"requesttime\"];\n  const PM_STATUS = [\"status\", \"à¸ªà¸–à¸²à¸™à¸°\"];\n  // Some provider withdrawal exports omit every time column while a payout is\n  // still Pending. They remain valid control files: the pending rows must be\n  // excluded, but the file itself must not fail the quality gate. Require a\n  // provider-specific identity column before accepting this no-date layout so\n  // an unrelated status/amount table cannot be misclassified as PM.\n  const PM_IDENTITY = [\"paymentid\", \"ref1\", \"ref2\", \"refid\", \"orderid\", \"transactionid\"];\n  const PM_AMT_DEP = [\"à¹‚à¸­à¸™à¸ˆà¸£à¸´à¸‡\", \"à¸ˆà¸³à¸™à¸§à¸™à¸—à¸µà¹ˆà¹„à¸”à¹‰à¸£à¸±à¸š\", \"à¸ˆà¸³à¸™à¸§à¸™à¹€à¸‡à¸´à¸™\", \"amount\", \"à¸ªà¸£à¹‰à¸²à¸‡à¸à¸²à¸\", \"realamount\"];\n  const PM_AMT_WIT = [\"transferredamount\", \"p2pà¸ˆà¹ˆà¸²à¸¢\", \"p2p à¸ˆà¹ˆà¸²à¸¢\", \"à¹‚à¸­à¸™à¸ˆà¸£à¸´à¸‡\", \"à¸£à¸§à¸¡à¸«à¸±à¸à¹€à¸‡à¸´à¸™\", \"à¸ˆà¸³à¸™à¸§à¸™à¹€à¸‡à¸´à¸™\", \"amount\"];\n  const anyCol = (cells, names) => names.some((n) => cells.some((c) => c === norm(n) || c.startsWith(norm(n))));\n  function detectPM(rows) {\n    for (let i = 0; i < Math.min(rows.length, 30); i++) {\n      const cells = (rows[i] || []).map(norm).filter(Boolean);\n      if (cells.length < 3) continue;\n      const hasDate = anyCol(cells, PM_DATE);\n      const hasPendingLayoutIdentity = anyCol(cells, PM_IDENTITY);\n      if ((hasDate || hasPendingLayoutIdentity) && anyCol(cells, PM_STATUS) && anyCol(cells, [...PM_AMT_DEP, ...PM_AMT_WIT])) {\n        const idx = {};\n        const exactIdx = {};\n        (rows[i] || []).forEach((raw, j) => {\n          const k = norm(raw);\n          if (k && idx[k] === undefined) idx[k] = j;\n          const exact = exactHeader(raw);\n          if (exact && exactIdx[exact] === undefined) exactIdx[exact] = j;\n        });\n        // à¸Šà¸·à¹ˆà¸­à¸šà¸£à¸´à¸©à¸±à¸—à¸¢à¹ˆà¸­à¸¢à¸ˆà¸²à¸à¹à¸–à¸§à¸«à¸±à¸§à¹€à¸£à¸·à¹ˆà¸­à¸‡à¸”à¹‰à¸²à¸™à¸šà¸™ (à¹€à¸Šà¹ˆà¸™ UFABET7M)\n        let title = \"\";\n        for (let k = 0; k < i; k++) {\n          const first = String((rows[k] || [])[0] || \"\").trim();\n          if (first) { title = first; break; }\n        }\n        // à¸£à¸²à¸¢à¸‡à¸²à¸™à¸ˆà¸²à¸ Provider à¸„à¸·à¸­ statement à¸à¸±à¹ˆà¸‡ PM à¸—à¸µà¹ˆà¸•à¹‰à¸­à¸‡à¸™à¸³à¹„à¸›à¸Šà¸™à¸à¸±à¸š BO\n        // à¹„à¸¡à¹ˆà¹ƒà¸Šà¹ˆ BO à¹€à¸­à¸‡ à¸¡à¸´à¸‰à¸°à¸™à¸±à¹‰à¸™à¸£à¸°à¸šà¸šà¸ˆà¸°à¹€à¸­à¸²à¸£à¸²à¸¢à¸‡à¸²à¸™à¸—à¸±à¹‰à¸‡à¸ªà¸­à¸‡à¸à¸±à¹ˆà¸‡à¹„à¸›à¸£à¸§à¸¡à¸à¸±à¸™à¹à¸¥à¸°à¹à¸ˆà¹‰à¸‡ missing à¸œà¸´à¸”à¸ˆà¸³à¸™à¸§à¸™à¸¡à¸²à¸\n        return { spec: { code: \"pm_provider\", label: \"à¸£à¸²à¸¢à¸à¸²à¸£ PM (payment gateway)\", side: \"stm\" }, headerIdx: i, idx, exactIdx, title };\n      }\n    }\n    return null;\n  }\n\n  /* à¸«à¸² header row à¸ à¸²à¸¢à¹ƒà¸™ 30 à¸šà¸£à¸£à¸—à¸±à¸”à¹à¸£à¸ à¸£à¸­à¸‡à¸£à¸±à¸šà¸«à¸±à¸§à¹€à¸£à¸·à¹ˆà¸­à¸‡/à¹à¸–à¸§à¸§à¹ˆà¸²à¸‡/merged cells à¸”à¹‰à¸²à¸™à¸šà¸™ */\n  function detect(rows) {\n    for (let i = 0; i < Math.min(rows.length, 30); i++) {\n      const cells = (rows[i] || []).map(norm);\n      if (!cells.length) continue;\n      for (const spec of SPECS) {\n        if (spec.need.every((w) => hasHeader(cells, w))) {\n          const idx = {};\n          const exactIdx = {};\n          (rows[i] || []).forEach((raw, j) => {\n            const k = norm(raw);\n            if (k && idx[k] === undefined) idx[k] = j;\n            const exact = exactHeader(raw);\n            if (exact && exactIdx[exact] === undefined) exactIdx[exact] = j;\n          });\n          return { spec, headerIdx: i, idx, exactIdx };\n        }\n      }\n    }\n    return null;\n  }\n\n  const col = (f, name) => {\n    for